@page "/"
@using OpenLayers.Blazor
@using Services
@using BusinessObjects
@using Helper
@inject ActivityService activityService;
@inject IJSRuntime JS;
@rendermode InteractiveServer

<OpenStreetMap ConfigureJsMethod="myMapConfig"
               Style="border:0px;height: 500px; width: 100%;"
               ZoomChanged="OnZoomChanged"
               OnClick="OnClick"
               @ref="map">
    <Popup>
        <div class="custom-map-popup">
            @if (context is Marker marker && !string.IsNullOrWhiteSpace(marker.Text))
            {
                @foreach (var line in marker.Text.Split('\n'))
                {
                    <div class="popup-line">@line</div>
                }
            }
        </div>
    </Popup>
    <Features>
        @if (popupCoordinate != null && !string.IsNullOrWhiteSpace(popupContent))
        {
            <Marker Type="MarkerType.MarkerFlag"
                    Coordinate="popupCoordinate.Value"
                    Text="@popupContent"
                    Popup 
                    @key="markerKey" />
        }
    </Features>
    <Layers>
        @if(graphFull is not null)
        {
            List<QuadTree> quadTrees = graphFull.QuadTree.GetAllLeaves();

            <Layer LayerType="LayerType.Vector" SourceType="SourceType.Vector">
                <Shapes>
                    @foreach(var quadTree in quadTrees)
                    {
                        <Polygon Points="@([
                                new Coordinate(quadTree.Extent.X1 , quadTree.Extent.Y1),
                                 new Coordinate(quadTree.Extent.X2, quadTree.Extent.Y1),
                                 new Coordinate(quadTree.Extent.X2, quadTree.Extent.Y2),
                                 new Coordinate(quadTree.Extent.X1, quadTree.Extent.Y2),
                                 new Coordinate(quadTree.Extent.X1 , quadTree.Extent.Y1)
                                ])" 
                        Fill="#0000" 
                        Stroke="#0004"
                        StrokeThickness="2" />
                    }
                </Shapes>
            </Layer>
        }
    </Layers>
</OpenStreetMap>
@code {
    Graph displayedGraph;
    Graph graphFull;
    Graph graph2;
    Graph graph3;
    OpenStreetMap map;
    private Guid markerKey = Guid.NewGuid();

    public string popupContent;
    public Coordinate? popupCoordinate;

    private void OnClick(Coordinate coordinate)
    {
        var edge = graphFull.FindEdge(coordinate.Latitude, coordinate.Longitude);

        // Instead of map.MarkersList.Clear(), resetting state tells Blazor to remove it
        if (edge is null)
        {
            popupContent = null;
            popupCoordinate = null;
            return;
        }

        var center = edge.GetCenter(graphFull);
        if (center.DistanceTo(coordinate) > 100)
        {
            popupContent = null;
            popupCoordinate = null;
            return;
        }

        markerKey = Guid.NewGuid();
        popupCoordinate = center;
        popupContent = $"Average Speed: {edge.AverageSpeed:F2}\n" +
                       $"Average Heartrate: {edge.AverageHeartRate:F2} BPM\n" +
                       $"Total Activities: {edge.ActivityFileNames.Count}\n";

        StateHasChanged();
    }

    private async void OnZoomChanged(double zoomLevel)
    {
        if (zoomLevel < 8)
        {
            await SetGraph(graph3);
        }
        else if (zoomLevel < 12)
        {
            await SetGraph(graph2);
        }
        else
        {
            await SetGraph(graphFull);
        }
    }

    private async Task SetGraph(Graph graph)
    {
        if (displayedGraph == graph)
            return;

        displayedGraph = graph;
        await RenderEdgesViaJS(displayedGraph);
    }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        var activities = await activityService.GetActivities();
        graphFull = new(activities);
        graph2 = new(graphFull, 40);
        graph3 = new(graphFull, 80);
    }

    private async Task RenderEdgesViaJS(Graph targetGraph)
    {
        var edges = targetGraph.Edges.Values
            .Select(e => new
            {
                start = new[] { targetGraph.Nodes[e.StartNodeKey].Longitude, targetGraph.Nodes[e.StartNodeKey].Latitude },
                end = new[] { targetGraph.Nodes[e.EndNodeKey].Longitude, targetGraph.Nodes[e.EndNodeKey].Latitude },
                color = $"rgba({(int)(e.AverageSpeed * 50)},0,{e.ActivityFileNames.Count * 50},1)"
            });

        await JS.InvokeVoidAsync("setEdges", edges, "map_2");
    }
}