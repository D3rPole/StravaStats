@page "/"
@using OpenLayers.Blazor
@using Services
@using BusinessObjects
@inject ActivityService activityService;
@rendermode InteractiveServer

<OpenStreetMap Style="border:0px;height: 500px; width: 100%;"
               ZoomChanged="OnZoomChanged">
    <Layers>
        @if (activityGrid is not null)
        {
            int i = 0;
            <Layer LayerType="LayerType.Heatmap"
                   SourceType="SourceType.VectorGeoJson"
                   Url="/api/heatmap.json"
                   Options="@HeatmapOptions" />
        }
    </Layers>
</OpenStreetMap>

@code {
    ActivityGrid activityGrid;

    private object HeatmapOptions = new
    {
        blur = 15,
        radius = 8,
        weight = "weight"
    };

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        activityGrid = await activityService.GetActivityGrid();
        var geoJson = activityGrid.GetHeatmapGeoJson();
        StateHasChanged();
    }

    private void OnZoomChanged(double newZoom)
    {
        UpdateHeatmapOptions(newZoom);
        StateHasChanged();
    }

    private void UpdateHeatmapOptions(double zoom)
    {
        double dynamicRadius = Math.Max(0.3, (zoom - 6) * 1.5);
        double dynamicBlur = dynamicRadius * 1.5;

        HeatmapOptions = new
        {
            blur = (int)dynamicBlur,
            radius = (int)dynamicRadius,
            weight = "weight"
        };
    }
}