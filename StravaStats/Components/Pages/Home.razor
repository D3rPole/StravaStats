@page "/"
@using Nextended.Core.Contracts
@using Nextended.Core.Types
@using OpenLayers.Blazor
@using StravaStats.Helper;
@using Services
@using BusinessObjects
@using Enums
@inject AccountService accountService
@inject IConfiguration configuration
@inject IJSRuntime JS
@inject ILogger<Home> logger

<div>
    <MudCard Class="ma-2">
        <div class="d-flex">
            <MudButton Disabled="@(selectedAccount is null)"
                       Variant="Variant.Filled"
                       Color="MudBlazor.Color.Primary"
                       OnClick="ResetClicked"
                       Class="ma-2">
                Reset
            </MudButton>
            <MudDatePicker Date="Start"
                           Disabled="@(selectedAccount is null)"
                           DateChanged="OnStartDateChanged"
                           Class="ma-2" />
            <MudDatePicker Date="End"
                           Disabled="@(selectedAccount is null)"
                           DateChanged="OnEndDateChanged"
                           Class="ma-2" />
            <MudExDateRangeSlider @ref="_slider"
                                  Disabled="@(selectedAccount is null)"
                                  Mode="_mode"
                                  EnableMouseWheelZoom="_zoom"
                                  SizeRange="@_sizeRange"
                                  Value="dateRange"
                                  ValueChanged="OnRangeChanged"
                                  AllowWholeRangeDrag="true"
                                  Class="ma-2" />
        </div>
        <MudDivider />
        <div class="d-flex">
            <MudSelect Label="Account" T="Account" ValueChanged="SelectedAccountChanged" Class="pa-2">
                @foreach (var account in accountService.Accounts)
                {
                    <MudSelectItem Value="@account">@account.Name</MudSelectItem>
                }
            </MudSelect>

            <MudSelect Disabled="@(selectedAccount is null)"
                       Label="Metric"
                       T="Metric"
                       ValueChanged="SelectedMetricChanged"
                       Class="pa-2">
                <MudSelectItem Value="Metric.Count" />
                <MudSelectItem Value="Metric.HeartRate" />
                <MudSelectItem Value="Metric.Velocity" />
                <MudSelectItem Value="Metric.Acceleration" />
                <MudSelectItem Value="Metric.Wattage" />
                <MudSelectItem Value="Metric.Grade" />
            </MudSelect>

            <MudSelect Label="Map" T="String" @bind-Value="@mapLink" Class="pa-2">
                <MudSelectItem Value="@("""https://tile.openstreetmap.de/{z}/{x}/{y}.png""")">Default OSM</MudSelectItem>
                <MudSelectItem Value="@("""https://tiles.stadiamaps.com/tiles/alidade_smooth_dark/{z}/{x}/{y}.png""")">Darkmode</MudSelectItem>
                <MudSelectItem Value="@("""https://tiles.stadiamaps.com/tiles/alidade_satellite/{z}/{x}/{y}.jpg""")">Satelite</MudSelectItem>
            </MudSelect>

            <div class="d-flex align-content-center">
                <MudIconButton OnClick="@(() => SelectGrade(GradeSelection.All))"
                               Icon="@(gradeSelection == GradeSelection.All ? Components.Icons.ArrowUpRightSquare : Components.Icons.ArrowDownRightSquareFill)"
                               Color="MudBlazor.Color.Primary"
                               Size="Size.Large"
                               Disabled="@(selectedAccount is null)" />
                <MudIconButton OnClick="@(() => SelectGrade(GradeSelection.Uphill))"
                               Icon="@(gradeSelection == GradeSelection.Uphill ? Components.Icons.ArrowUpRightSquare : Components.Icons.ArrowDownRightSquareFill)"
                               Color="MudBlazor.Color.Primary"
                               Size="Size.Large"
                               Disabled="@(selectedAccount is null)" />
                <MudIconButton OnClick="@(() => SelectGrade(GradeSelection.Downhill))"
                               Icon="@(gradeSelection == GradeSelection.Downhill ? Components.Icons.ArrowDownRightSquare : Components.Icons.ArrowUpRightSquareFill)"
                               Color="MudBlazor.Color.Primary"
                               Size="Size.Large"
                               Disabled="@(selectedAccount is null)" />
            </div>
        </div>
    </MudCard>
    <div class="d-inline-flex" style="width:100%;">
        <div class="my-map-container flex-grow-1">
            @if (isLoading)
            {
                <div class="map-loading"></div>
            }
            <MudCard Class="@("stats-overlay" + (statsExpanded ? " enabled" : ""))">
                <MudButton OnClick="StatsExpandClicked" Class="d-flex" Disabled="@(displayedGraph is null || displayedGraph.Edges.Count() == 0)">
                    <MudText Class="flex-grow-1 align-self-center pl-2" Typo="Typo.h6">Stats</MudText>
                    <MudIcon Icon="@(statsExpanded ? MudBlazor.Icons.Material.Filled.ArrowDropUp : MudBlazor.Icons.Material.Filled.ArrowDropDown)" />
                </MudButton>
                <MudCollapse Expanded="@(statsExpanded)">
                    @if (selectedMetrics is not null)
                    {
                        <MudDivider Class="ma-2" />
                        <MudText Class="flex-grow-1 align-self-center pl-2" Typo="Typo.body2">Maximums</MudText>
                        <MudDivider Class="ma-2" />
                        <MudText Typo="Typo.body1">Max Velocity: @($"{selectedMetrics.Speed.MaxValue:F2}") Km/h</MudText>
                        <MudText Typo="Typo.body1">Max Acceleration: @($"{selectedMetrics.Acceleration.MaxValue:F2}") m/s²</MudText>
                        <MudText Typo="Typo.body1">Max Wattage: @($"{selectedMetrics.Wattage.MaxValue:F2}") W</MudText>
                        <MudText Typo="Typo.body1">Max Heartrate: @($"{selectedMetrics.HeartRate.MaxValue:F2}") BPM</MudText>
                        <MudText Typo="Typo.body1">Max Grade: @($"{selectedMetrics.Grade.MaxValue:F2}") %</MudText>
                        <MudText Typo="Typo.body1">Min Grade: @($"{selectedMetrics.Grade.MinValue:F2}") %</MudText>
                        <MudDivider Class="ma-2" />
                        <MudText Class="flex-grow-1 align-self-center pl-2" Typo="Typo.body2">Averages</MudText>
                        <MudDivider Class="ma-2" />
                        <MudText Typo="Typo.body1">Average Velocity: @($"{selectedMetrics.Speed.Average:F2}") Km/h</MudText>
                        <MudText Typo="Typo.body1">Average Acceleration: @($"{selectedMetrics.Acceleration.Average:F2}") m/s²</MudText>
                        <MudText Typo="Typo.body1">Average Wattage: @($"{selectedMetrics.Wattage.Average:F2}") W</MudText>
                        <MudText Typo="Typo.body1">Average Heartrate: @($"{selectedMetrics.HeartRate.Average:F2}") BPM</MudText>
                        <MudText Typo="Typo.body1">Average Grade: @($"{selectedMetrics.Grade.Average:F2}") %</MudText>
                    }
                </MudCollapse>
            </MudCard>

            <div id="map">
                <Map ConfigureJsMethod="myMapConfig"
                     OnClick="OnClick"
                     InitialZoom="8"
                     InitialCenter="new OpenLayers.Blazor.Coordinate(7.71667, 52.28333)"
                     @ref="map"
                     @key="@mapLink">
                    <Features>
                        @if (popupCoordinate != null && !string.IsNullOrWhiteSpace(popupContent))
                        {
                            <Marker Fill="@GetPrimaryColorString()"
                                    Stroke="@GetBlackColorString()"
                                    TextColor="@GetTextColorString()"
                                    Coordinate="popupCoordinate.Value"
                                    Text="@popupContent"
                                    Popup
                                    Type="MarkerType.MarkerFlag"
                                    @key="markerKey">
                            </Marker>
                        }
                        @if (selectedMetrics is not null && !isLoading && statsExpanded)
                        {
                            <Marker Fill="@GetPrimaryColorString()"
                                    Stroke="@GetBlackColorString()"
                                    TextColor="@GetTextColorString()"
                                    Coordinate="@(selectedMetrics.Speed.MaxPosition.ToOpenLayersCoordinate())"
                                    Popup
                                    Type="MarkerType.MarkerFlag"
                                    Text="@($"Max Speed: {selectedMetrics.Speed.MaxValue:F2} km/h")"
                                    @key="@("speed-" + selectedMetrics.GetHashCode())" />
                            <Marker Fill="@GetPrimaryColorString()"
                                    Stroke="@GetBlackColorString()"
                                    TextColor="@GetTextColorString()"
                                    Coordinate="@(selectedMetrics.Acceleration.MaxPosition.ToOpenLayersCoordinate())"
                                    Popup
                                    Type="MarkerType.MarkerFlag"
                                    Text="@($"Max Acceleration: {selectedMetrics.Acceleration.MaxValue:F2} m/s²")"
                                    @key="@("acceleration-" + selectedMetrics.GetHashCode())" />
                            <Marker Fill="@GetPrimaryColorString()"
                                    Stroke="@GetBlackColorString()"
                                    TextColor="@GetTextColorString()"
                                    Coordinate="@(selectedMetrics.HeartRate.MaxPosition.ToOpenLayersCoordinate())"
                                    Popup
                                    Type="MarkerType.MarkerFlag"
                                    Text="@($"Max Heartrate: {selectedMetrics.HeartRate.MaxValue:F2} bpm")"
                                    @key="@("heartrate-" + selectedMetrics.GetHashCode())" />
                            <Marker Fill="@GetPrimaryColorString()"
                                    Stroke="@GetBlackColorString()"
                                    TextColor="@GetTextColorString()"
                                    Coordinate="@(selectedMetrics.Grade.MaxPosition.ToOpenLayersCoordinate())"
                                    Popup
                                    Type="MarkerType.MarkerFlag"
                                    Text="@($"Max Grade: {(selectedMetrics.Grade.MaxValue):F2} %")"
                                    @key="@("mac-grade-" + selectedMetrics.GetHashCode())" />
                            <Marker Fill="@GetPrimaryColorString()"
                                    Stroke="@GetBlackColorString()"
                                    TextColor="@GetTextColorString()"
                                    Coordinate="@(selectedMetrics.Grade.MinPosition.ToOpenLayersCoordinate())"
                                    Popup
                                    Type="MarkerType.MarkerFlag"
                                    Text="@($"Min Grade: {(selectedMetrics.Grade.MinValue):F2} %")"
                                    @key="@("min-grade-" + selectedMetrics.GetHashCode())" />
                            <Marker Fill="@GetPrimaryColorString()"
                                    Stroke="@GetBlackColorString()"
                                    TextColor="@GetTextColorString()"
                                    Coordinate="@(selectedMetrics.Wattage.MaxPosition.ToOpenLayersCoordinate())"
                                    Popup
                                    Type="MarkerType.MarkerFlag"
                                    Text="@($"Max Wattage: {selectedMetrics.Wattage.MaxValue:F2} W")"
                                    @key="@("wattage-" + selectedMetrics.GetHashCode())" />
                        }
                    </Features>
                    <Layers>
                        <Layer LayerType="LayerType.Tile"
                               SourceType="SourceType.XYZ"
                               Url="@mapLink" />
                        @if (displayedGraph is not null)
                        {
                            List<QuadTree> quadTrees = displayedGraph.QuadTree.GetAllLeaves();

                            <Layer LayerType="LayerType.Vector" SourceType="SourceType.Vector">
                                <Shapes>
                                    @if (configuration.GetValue<bool>("ShowQuadTree"))
                                    {
                                        @foreach (var quadTree in quadTrees)
                                        {
                                            List<OpenLayers.Blazor.Coordinate> points = [
                                                new(quadTree.BoundingBox.X1, quadTree.BoundingBox.Y1),
                                                new OpenLayers.Blazor.Coordinate(quadTree.BoundingBox.X2, quadTree.BoundingBox.Y1),
                                                new OpenLayers.Blazor.Coordinate(quadTree.BoundingBox.X2, quadTree.BoundingBox.Y2),
                                                new OpenLayers.Blazor.Coordinate(quadTree.BoundingBox.X1, quadTree.BoundingBox.Y2),
                                                new OpenLayers.Blazor.Coordinate(quadTree.BoundingBox.X1, quadTree.BoundingBox.Y1)];
                                            <Polygon Points="points"
                                                     Fill="#0000"
                                                     Stroke="#0001"
                                                     StrokeThickness="2" />
                                        }
                                    }
                                </Shapes>
                            </Layer>
                        }
                    </Layers>
                </Map>
            </div>

            <div class="@("activities-list-card" + (listExpanded ? " enabled" : ""))">
                <MudCard Class="activities-list">
                    <MudButton OnClick="ListExpandClicked" Class="d-flex" Disabled="@(selectedAccount is null || selectedAccount.SelectedActivities is null)">
                        <MudText Class="flex-grow-1 align-self-center pl-2" Typo="Typo.h6">Activities</MudText>
                        <MudIcon Icon="@(listExpanded ? MudBlazor.Icons.Material.Filled.ArrowDropUp : MudBlazor.Icons.Material.Filled.ArrowDropDown)" />
                    </MudButton>
                    <MudCollapse Expanded="@(listExpanded)">
                        <MudDivider />
                        @if (selectedAccount is not null && selectedAccount.SelectedActivities is not null)
                        {
                            <MudDataGrid Dense="true" T="Activity" MultiSelection="true" Items="selectedAccount.SelectedActivities" @bind-SelectedItems="SelectedActivities">
                                <Columns>
                                    <SelectColumn T="Activity" />
                                    <TemplateColumn Title="Name" Sortable="true" SortBy="x => x.ActivityHeader.Name">
                                        <CellTemplate>
                                            <MudText Style="width: 150px; text-overflow: ellipsis; overflow: hidden; white-space: nowrap; display: block;" Typo="Typo.body1">@context.Item.ActivityHeader.Name</MudText>
                                        </CellTemplate>
                                    </TemplateColumn>
                                    <TemplateColumn Title="Distance" Sortable="true" SortBy="x => x.ActivityHeader.Distance">
                                        <CellTemplate>
                                            @($"{context.Item.ActivityHeader.Distance / 1000.0:F2} Km")
                                        </CellTemplate>
                                    </TemplateColumn>
                                    <TemplateColumn Title="Popup" Sortable="true" SortBy="x => (popupActivities != null && popupActivities.Contains(x.ActivityHeader.Id)) ? 1 : 0">
                                        <CellTemplate>
                                            @if (popupActivities is not null && popupActivities.Contains(context.Item.ActivityHeader.Id))
                                            {
                                                <MudIcon Icon="@MudBlazor.Icons.Material.Filled.LocationOn" Color="MudBlazor.Color.Primary" />
                                            }
                                        </CellTemplate>
                                    </TemplateColumn>
                                    <TemplateColumn Title="Date" Sortable="true" SortBy="x => x.ActivityHeader.StartDate">
                                        <CellTemplate>
                                            <MudText Style="text-wrap: nowrap" Typo="Typo.body1">@($"{context.Item.ActivityHeader.StartDate:dd.MM.yyyy}")</MudText>
                                        </CellTemplate>
                                    </TemplateColumn>
                                </Columns>
                            </MudDataGrid>
                        }
                    </MudCollapse>
                </MudCard>
            </div>
        </div>

    </div>
</div>

@code {
    private void SelectGrade(GradeSelection gradeSelection)
    {
        this.gradeSelection = gradeSelection;
        SetSelectedMetrics();
        UpdateDisplayedGraph();
        StateHasChanged();
    }
    GradeSelection gradeSelection = GradeSelection.All;
    HashSet<Activity> SelectedActivities
    {
        get => field;
        set
        {
            field = value;
            displayedGraph = null;
            if (selectedAccount is null || selectedAccount.SelectedGraph is null)
            {
                UpdateDisplayedGraph();
                return;
            }
            SetSelectedMetrics();
            UpdateDisplayedGraph();
        }
    } = [];
    private void SetSelectedMetrics()
    {
        if (selectedAccount is null || selectedAccount.SelectedGraph is null)
            return;
        if (SelectedActivities is not null && SelectedActivities.Count > 0)
        {
            selectedMetrics = new Metrics();
            foreach (var activity in SelectedActivities)
            {
                switch (gradeSelection)
                {
                    case GradeSelection.All:
                        selectedMetrics.AddMetrics(activity.Graph.AllMetrics);
                        break;
                    case GradeSelection.Uphill:
                        selectedMetrics.AddMetrics(activity.Graph.UphillMetrics);
                        break;
                    case GradeSelection.Downhill:
                        selectedMetrics.AddMetrics(activity.Graph.DownhillMetrics);
                        break;
                }
            }
            return;
        }
        switch (gradeSelection)
        {
            case GradeSelection.All:
                selectedMetrics = selectedAccount.SelectedGraph.AllMetrics;
                break;
            case GradeSelection.Uphill:
                selectedMetrics = selectedAccount.SelectedGraph.UphillMetrics;
                break;
            case GradeSelection.Downhill:
                selectedMetrics = selectedAccount.SelectedGraph.DownhillMetrics;
                break;
        }
    }
    Metrics selectedMetrics;
    Action UpdateGraphAction;
    private bool isLoading;
    Graph displayedGraph;
    Map map;
    Account selectedAccount;
    private Metric displayedMetric;
    private Guid markerKey = Guid.NewGuid();
    bool _listExpanded;
    bool listExpanded => _listExpanded && selectedAccount is not null && selectedAccount.SelectedActivities is not null;
    bool _statsExpanded;
    bool statsExpanded => _statsExpanded && displayedGraph is not null && displayedGraph.Edges.Count() > 0;

    public void StatsExpandClicked()
    {
        _statsExpanded = !_statsExpanded;
    }

    public void ListExpandClicked()
    {
        _listExpanded = !_listExpanded;
    }

    public string mapLink
    {
        get
        {
            return field;
        }
        set
        {
            field = value;
            StateHasChanged();
        }
    }

    public string popupContent;
    HashSet<long>? popupActivities;
    public OpenLayers.Blazor.Coordinate? popupCoordinate;

    #region DateRange

    private MudExDateRangeSlider? _slider;
    private DateRangeSliderMode _mode = DateRangeSliderMode.Day;
    private bool _zoom = true;
    private static readonly DateOnly Today = DateOnly.FromDateTime(DateTime.Today);
    private IRange<DateOnly> _sizeRange = new RangeOf<DateOnly>(Today.AddYears(-2), Today.AddYears(2), null);
    private DateTime Start
    {
        get => field; set
        {
            if (value > End)
                field = End;
            else
                field = value;
            manualRangeChange = true;
            dateRange = new RangeOf<DateOnly>(DateOnly.FromDateTime(field), dateRange.End, null);
        }
    }
    private DateTime End
    {
        get => field; set
        {
            if (value < Start)
                field = Start;
            else
                field = value;
            manualRangeChange = true;
            dateRange = new RangeOf<DateOnly>(dateRange.Start, DateOnly.FromDateTime(field), null);
        }
    }
    private bool manualRangeChange;
    private IRange<DateOnly> dateRange
    {
        get => field; set
        {
            field = value;
            if (dateRange is null)
                return;
            if (manualRangeChange)
            {
                manualRangeChange = false;
                return;
            }
            Start = field.Start.ToDateTime(TimeOnly.MinValue);
            End = field.End.ToDateTime(TimeOnly.MaxValue);
        }
    }

    private string GetPrimaryColorString()
    {
        var theme = new MudTheme();
        string primaryHex = theme.PaletteLight.Primary.ToString();
        return primaryHex;
    }

    private string GetTextColorString()
    {
        var theme = new MudTheme();
        string primaryHex = theme.PaletteLight.White.ToString();
        return primaryHex;
    }

    private string GetBlackColorString()
    {
        var theme = new MudTheme();
        string primaryHex = theme.PaletteLight.Black.ToString();
        return primaryHex;
    }

    private void OnRangeChanged(IRange<DateOnly> newValue)
    {
        dateRange = newValue;

        if (selectedAccount is null)
            return;
        UpdateDisplayedGraph();
    }

    private void OnStartDateChanged(DateTime? value)
    {
        if (value is null)
            return;
        Start = value.Value;

        if (selectedAccount is null)
            return;
        UpdateDisplayedGraph();
    }

    private void OnEndDateChanged(DateTime? value)
    {
        if (value is null)
            return;
        End = value.Value;

        if (selectedAccount is null)
            return;
        UpdateDisplayedGraph();
    }

    private void ResetClicked()
    {
        if (selectedAccount is null)
            return;
        Start = new(DateOnly.FromDateTime(selectedAccount.StartDateRange), TimeOnly.MinValue);
        End = new(DateOnly.FromDateTime(selectedAccount.EndDateRange), TimeOnly.MaxValue);
        SetSelectedMetrics();
        SelectedActivities = [];
        _sizeRange = dateRange;
        UpdateDisplayedGraph();
    }

    #endregion

    #region Selections

    private async Task SelectedMetricChanged(Metric metric)
    {
        if (selectedAccount is null || displayedGraph is null)
            return;

        displayedMetric = metric;
        displayedGraph = null;
        UpdateDisplayedGraph();
    }

    private async Task SelectedAccountChanged(Account account)
    {
        selectedAccount = account;
        displayedGraph = null;
        UpdateDisplayedGraph();

        if (selectedAccount is null)
            return;

        Start = new(DateOnly.FromDateTime(selectedAccount.StartDateRange), TimeOnly.MinValue);
        End = new(DateOnly.FromDateTime(selectedAccount.EndDateRange), TimeOnly.MaxValue);
        SetSelectedMetrics();
        _sizeRange = dateRange;
    }

    #endregion

    #region Graph

    private void OnClick(OpenLayers.Blazor.Coordinate coordinate)
    {
        if (selectedAccount is null)
            return;

        if (displayedGraph is null)
            return;

        var edge = displayedGraph.FindEdge(coordinate.Latitude, coordinate.Longitude);

        // Instead of map.MarkersList.Clear(), resetting state tells Blazor to remove it
        if (edge is null)
        {
            popupContent = null;
            popupCoordinate = null;
            return;
        }

        var center = edge.GetCenter(selectedAccount.FullGraph);
        if (center.DistanceTo(coordinate) > 0.5)
        {
            popupContent = null;
            popupCoordinate = null;
            return;
        }

        markerKey = Guid.NewGuid();
        popupCoordinate = center;
        Metrics metrics;
        switch (gradeSelection)
        {
            case GradeSelection.All:
                metrics = edge.AllMetrics;
                break;
            case GradeSelection.Uphill:
                metrics = edge.UphillMetrics;
                break;
            case GradeSelection.Downhill:
                metrics = edge.DownhillMetrics;
                break;
            default:
                metrics = edge.AllMetrics;
                break;
        }
        popupContent = $"Total Activities: {edge.ActivityIds.Count}\n" +
                        $"Average Heartrate: {metrics.HeartRate.Average:F2} BPM\n" +
                        $"Grade: {metrics.Grade.Average:F2} %\n" +
                        $"Average Speed: {metrics.Speed.Average:F2} Km/h\n" +
                        $"Average Acceleration: {metrics.Acceleration.Average:F2} m/s²\n" +
                        $"Max Acceleration: {metrics.Acceleration.MaxValue:F2} m/s²\n" +
                        $"Average Wattage: {metrics.Wattage.Average:F2} W\n";

        popupActivities = edge.ActivityIds;

        StateHasChanged();
    }

    private async void UpdateDisplayedGraph()
    {
        UpdateGraphAction.Invoke();
    }

    private async Task SetGraph(Graph graph)
    {
        if (graph is null)
            return;

        displayedGraph = graph;
        await RenderEdgesViaJS(displayedGraph);
    }

    private async Task RenderEdgesViaJS(Graph targetGraph)
    {
        var edges = targetGraph.Edges.Values
                    .Select(e =>
                    {
                        var start = new[] { targetGraph.Nodes[e.EdgeKey.StartNodeKey].Coordinate.Longitude, targetGraph.Nodes[e.EdgeKey.StartNodeKey].Coordinate.Latitude };
                        var end = new[] { targetGraph.Nodes[e.EdgeKey.EndNodeKey].Coordinate.Longitude, targetGraph.Nodes[e.EdgeKey.EndNodeKey].Coordinate.Latitude };

                        BusinessObjects.Color color = new();
                        if (e.ActivityIds.Any(id => SelectedActivities.Any(a => a.ActivityHeader.Id == id)))
                        {
                            return new
                            {
                                start = start,
                                end = end,
                                color = "#0f0"
                            };
                        }
                        float value = 0;
                        Metrics metrics;
                        switch (gradeSelection)
                        {
                            case GradeSelection.All:
                                metrics = e.AllMetrics;
                                break;
                            case GradeSelection.Uphill:
                                metrics = e.UphillMetrics;
                                break;
                            case GradeSelection.Downhill:
                                metrics = e.DownhillMetrics;
                                break;
                            default:
                                metrics = e.AllMetrics;
                                break;
                        }
                        switch (displayedMetric)
                        {
                            case Metric.Count:
                                value = e.ActivityIds.Count / 10f;
                                break;
                            case Metric.Velocity:
                                value = (float)metrics.Speed.Average / 25f;
                                break;
                            case Metric.HeartRate:
                                value = (float)metrics.HeartRate.Average / 150f;
                                break;
                            case Metric.Wattage:
                                value = (float)metrics.Wattage.Average / 100f;
                                break;
                            case Metric.Acceleration:
                                value = (float)metrics.Acceleration.Average * 2f;
                                break;
                            case Metric.Grade:
                                value = (float)metrics.Grade.Average / 12f;
                                break;
                        }
                        float positiveValue = Math.Clamp(value, 0, 2);
                        float negativeValue = Math.Clamp(-value, 0, 2);
                        color = new(
                            1f - negativeValue,
                            1f - positiveValue * 0.7f - negativeValue * 0.7f,
                            1f - positiveValue);

                        color.R = (byte)(color.R / 50 * 50);
                        color.G = (byte)(color.G / 50 * 50);
                        color.B = (byte)(color.B / 50 * 50);
                        string colorString = $"rgba({color.R},{color.G},{color.B},1)";
                        return new
                        {
                            start = start,
                            end = end,
                            color = colorString
                        };
                    }).ToList();

        double[] flatCoordinates = new double[targetGraph.Edges.Count * 4];
        string[] colors = new string[targetGraph.Edges.Count];
        for (int i = 0; i < edges.Count(); i++)
        {
            var edge = edges[i];
            colors[i] = edge.color;
            flatCoordinates[i * 4 + 0] = edge.start[0];
            flatCoordinates[i * 4 + 1] = edge.start[1];
            flatCoordinates[i * 4 + 2] = edge.end[0];
            flatCoordinates[i * 4 + 3] = edge.end[1];
        }

        await JS.InvokeVoidAsync("setEdges", flatCoordinates, colors);
    }

    #endregion

    #region Map

    [JSInvokable]
    public void MapInitialized()
    {
        displayedGraph = null;
        UpdateDisplayedGraph();
    }

    #endregion

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        dateRange = new RangeOf<DateOnly>(Today.AddMonths(-3), Today.AddMonths(3), null);

        UpdateGraphAction = new Func<Task>(async () =>
        {
            if (selectedAccount is null)
                return;

            isLoading = true;
            await InvokeAsync(StateHasChanged);
            await JS.InvokeVoidAsync("clearMap");
            long ticks = DateTime.Now.Ticks;
            selectedAccount.SelectRange(Start, End);
            long ticksAfter = DateTime.Now.Ticks;
            logger.LogInformation("SelectRange " + (ticksAfter - ticks) / TimeSpan.TicksPerMillisecond + " ms");
            ticks = DateTime.Now.Ticks;
            await SetGraph(selectedAccount.SelectedGraph);
            ticksAfter = DateTime.Now.Ticks;
            logger.LogInformation("SetGraph " + (ticksAfter - ticks) / TimeSpan.TicksPerMillisecond + " ms");
            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }).Debounce(TimeSpan.FromMilliseconds(200));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        if (firstRender)
        {
            mapLink = "https://tiles.stadiamaps.com/tiles/alidade_smooth_dark/{z}/{x}/{y}.png";
            await InitializeJS();
        }
    }

    private async Task InitializeJS()
    {
        var objRef = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("registerBlazorComponent", objRef);
    }

}