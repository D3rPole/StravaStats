@page "/"
@using OpenLayers.Blazor
@using Services
@using BusinessObjects
@using System.Globalization
@inject ActivityService activityService;
@rendermode InteractiveServer

<OpenStreetMap Style="border:0px;height: 500px; width: 100%;">
    <Layers>
        <Layer LayerType="LayerType.Vector"
               SourceType="SourceType.Vector">
            <Shapes>
                @if (graph is not null)
                {
                    foreach (var edge in graph.Edges)
                    {
                        <Line Coordinates="new([[graph.Nodes[edge.Value.StartNodeKey].Longitude, graph.Nodes[edge.Value.StartNodeKey].Latitude],
                                                [graph.Nodes[edge.Value.EndNodeKey].Longitude, graph.Nodes[edge.Value.EndNodeKey].Latitude]])"
                                                Stroke="@($"rgba({(edge.Value.AverageSpeed * 30).ToString(CultureInfo.InvariantCulture)},0,0,1)")"
                                            StrokeThickness="4" />
                    }
                }
            </Shapes>
        </Layer>
    </Layers>
</OpenStreetMap>

@code {
    Graph graph;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        var activities = await activityService.GetActivities();
        graph = new(activities);
        StateHasChanged();
    }
}