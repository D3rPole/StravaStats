@page "/"
@using OpenLayers.Blazor
@using Services
@using BusinessObjects
@using System.Globalization
@inject ActivityService activityService;
@rendermode InteractiveServer

<OpenStreetMap Style="border:0px;height: 500px; width: 100%;"
               ZoomChanged="OnZoomChanged">
    <Layers>
        <!--@if (activityGrid is not null)
        {
            int i = 0;
            <Layer LayerType="LayerType.Heatmap"
                   SourceType="SourceType.VectorGeoJson"
                   Url="/api/heatmap.json"
                   Options="@HeatmapOptions" />
        }
-->
        <Layer LayerType="LayerType.Vector"
               SourceType="SourceType.Vector">
            <Shapes>
                @if (activityGrid is not null)
                {
                    foreach (var activity in activityGrid)
                    {
                        if (activity.SimplifiedTrackingPoint.Count() < 2)
                            continue;
                    
                        for (int i = 0; i < activity.SimplifiedTrackingPoint.Count() - 1; i++)
                        {
                            var start = activity.SimplifiedTrackingPoint[i];
                            var end = activity.SimplifiedTrackingPoint[i + 1];
                            var speed = (start.Speed * 50 ?? 0).ToString(CultureInfo.InvariantCulture);
                            <Line Coordinates="@new(new double[][] {
                                    new double[] { start.Longitude, start.Latitude },
                                    new double[] { end.Longitude, end.Latitude } })"
                                  StrokeThickness="3" 
                                  Stroke="@($"rgba({speed},0,0,0.8)")" />
                            <Circle Coordinates="@new(new double[] { start.Longitude, start.Latitude })" Radius="5" Fill="#9f9" />
                        }
                    }
                }
            </Shapes>
        </Layer>
    </Layers>
</OpenStreetMap>

@code {
    List<Activity> activityGrid;

    private object HeatmapOptions = new
    {
        blur = 15,
        radius = 8,
        weight = "weight"
    };

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        activityGrid = await activityService.GetActivities();
        //var geoJson = activityGrid.GetHeatmapGeoJson();
        StateHasChanged();
    }

    private void OnZoomChanged(double newZoom)
    {
        UpdateHeatmapOptions(newZoom);
        StateHasChanged();
    }

    private void UpdateHeatmapOptions(double zoom)
    {
        double dynamicRadius = Math.Max(0.3, (zoom - 6) * 1.5);
        double dynamicBlur = dynamicRadius * 1.5;

        HeatmapOptions = new
        {
            blur = (int)dynamicBlur,
            radius = (int)dynamicRadius,
            weight = "weight"
        };
    }
}