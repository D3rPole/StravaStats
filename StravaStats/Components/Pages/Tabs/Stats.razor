@using StravaStats.BusinessObjects
@if (Metrics is not null && Graph is not null)
{
    <MudSimpleTable Dense>
        <thead>
            <tr>
                <th></th>
                <th>Minumum</th>
                <th>Maximum</th>
                <th>Total</th>
                <th>Average</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>Distance</td>
                <td>@($"{(Graph.Distance.MinValue / 1000):F2}") Km</td>
                <td>@($"{(Graph.Distance.MaxValue / 1000):F2}") Km</td>
                <td>@($"{(Graph.Distance.Total / 1000):F2}") Km</td>
                <td>@($"{(Graph.Distance.Average / 1000):F2}") Km</td>
            </tr>
            <tr>
                <td>Velocity</td>
                <td>@($"{Metrics.Speed.MinValue:F2}") Km/h</td>
                <td>@($"{Metrics.Speed.MaxValue:F2}") Km/h</td>
                <td></td>
                <td>@($"{Metrics.Speed.Average:F2}") Km/h</td>
            </tr>
            <tr>
                <td>Heartrate</td>
                <td>@($"{Metrics.HeartRate.MinValue:F2}") BPM</td>
                <td>@($"{Metrics.HeartRate.MaxValue:F2}") BPM</td>
                <td></td>
                <td>@($"{Metrics.HeartRate.Average:F2}") BPM</td>
            </tr>
            <tr>
                <td>Wattage</td>
                <td>@($"{Metrics.Wattage.MinValue:F2}") W</td>
                <td>@($"{Metrics.Wattage.MaxValue:F2}") W</td>
                <td></td>
                <td>@($"{Metrics.Wattage.Average:F2}") W</td>
            </tr>
            <tr>
                <td>Acceleration</td>
                <td>@($"{Metrics.Acceleration.MinValue:F2}") m/s²</td>
                <td>@($"{Metrics.Acceleration.MaxValue:F2}") m/s²</td>
                <td></td>
                <td> @($"{Metrics.Acceleration.Average:F2}") m/s²</td>
            </tr>
            <tr>
                <td>Time</td>
                <td>@($"{TimeSpan.FromSeconds(Graph.TotalTime.MinValue):hh\\:mm\\:ss}")</td>
                <td>@($"{TimeSpan.FromSeconds(Graph.TotalTime.MaxValue):hh\\:mm\\:ss}")</td>
                <td>@($"{TimeSpan.FromSeconds(Graph.TotalTime.Total):hh\\:mm\\:ss}")</td>
                <td> @($"{TimeSpan.FromSeconds(Graph.TotalTime.Average):hh\\:mm\\:ss}")</td>
            </tr>
            <tr>
                <td>Active time</td>
                <td>@($"{TimeSpan.FromSeconds(Graph.ActiveTime.MinValue):hh\\:mm\\:ss}")</td>
                <td>@($"{TimeSpan.FromSeconds(Graph.ActiveTime.MaxValue):hh\\:mm\\:ss}")</td>
                <td>@($"{TimeSpan.FromSeconds(Graph.ActiveTime.Total):hh\\:mm\\:ss}")</td>
                <td>@($"{TimeSpan.FromSeconds(Graph.ActiveTime.Average):hh\\:mm\\:ss}")</td>
            </tr>
            <tr>
                <td>Paused time</td>
                <td>@($"{TimeSpan.FromSeconds(Graph.TotalTime.MinValue - Graph.ActiveTime.MinValue):hh\\:mm\\:ss}")</td>
                <td>@($"{TimeSpan.FromSeconds(Graph.TotalTime.MaxValue - Graph.ActiveTime.MaxValue):hh\\:mm\\:ss}")</td>
                <td>@($"{TimeSpan.FromSeconds(Graph.TotalTime.Total - Graph.ActiveTime.Total):hh\\:mm\\:ss}")</td>
                <td>@($"{TimeSpan.FromSeconds(Graph.TotalTime.Average - Graph.ActiveTime.Average):hh\\:mm\\:ss}")</td>
            </tr>
            <tr>
                <td>Grade</td>
                <td>@($"{Metrics.Grade.MinValue:F2}") %</td>
                <td>@($"{Metrics.Grade.MaxValue:F2}") %</td>
                <td></td>
                <td>@($"{Metrics.Grade.Average:F2}") %</td>
            </tr>
        </tbody>
    </MudSimpleTable>
    <MudText Class="pa-2" Typo="Typo.body2">Pause Per Kilometer: @($"{TimeSpan.FromSeconds((Graph.TotalTime.Total - Graph.ActiveTime.Total) / Graph.Distance.Total * 1000):mm\\:ss' seconds'}")</MudText>
}

@code {
    [Parameter]
    public Graph Graph { get; set; }
    [Parameter]
    public Metrics Metrics { get; set; }
}
