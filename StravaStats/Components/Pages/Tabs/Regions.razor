@using StravaStats.BusinessObjects
@using StravaStats.BusinessObjects.Regions
@using StravaStats.Services
@inject RegionService CitiesService
<MudDataGrid SortMode="SortMode.Single" T="Region" Items="regions" MultiSelection SelectedItemsChanged="SelectedRegionsChanged">
    <Columns>
        <SelectColumn T="Region" />
        <TemplateColumn Title="Name"
                        Sortable="true"
                        SortBy="x => x.Name">
            <CellTemplate>
                <MudText Style="text-overflow: ellipsis; overflow: hidden; white-space: nowrap; display: block;" Typo="Typo.body1">@context.Item.Name</MudText>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn HeaderStyle="width: 80px;"
                        CellStyle="width:80px;"
                        Title="Country"
                        Sortable="true"
                        SortBy="x => x.Country">
            <CellTemplate>
                <MudText Style="text-overflow: ellipsis; overflow: hidden; white-space: nowrap; display: block;" Typo="Typo.body1">@context.Item.Country</MudText>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn HeaderStyle="width: 150px;"
                        CellStyle="width:150px;"
                        InitialDirection="SortDirection.Descending"
                        Title="Passed through"
                        Sortable="true"
                        SortBy="x => passedRegions.Any(r => r.Id == x.Id)">
            <CellTemplate>
                <MudCheckBox ReadOnly Value="passedRegions.Any(r => r.Id == context.Item.Id)" />
            </CellTemplate>
        </TemplateColumn>
    </Columns>
</MudDataGrid>

@code {
    [Parameter, EditorRequired] public Graph SelectedGraph { get => field; set { field = value; UpdatePassedRegions(); } }
    [Parameter] public List<City> PassedCitiesInRegion { get; set; }
    [Parameter] public EventCallback<List<City>> PassedCitiesInRegionChanged { get; set; }
    [Parameter] public List<City> NonPassedCitiesInRegion { get; set; }
    [Parameter] public EventCallback<List<City>> NonPassedCitiesInRegionChanged { get; set; }
    [Parameter] public EventCallback SelectionChanged { get; set; }

    HashSet<Region> passedRegions = [];
    List<Region> regions => CitiesService.GetRegions();
    List<City> cities => CitiesService.GetCities();

    private void UpdatePassedRegions()
    {
        if (SelectedGraph is null)
        {
            passedRegions = [];
            return;
        }
        passedRegions = regions.Where(r => SelectedGraph.RegionsPassed.Any(rp => rp == r.Id)).ToHashSet();
    }

    private async Task SelectedRegionsChanged(HashSet<Region> regions)
    {
        var citiesInSelectedRegions = cities.Where(c => regions.Any(r => r.Id == c.ParentId)).ToList();

        PassedCitiesInRegion = citiesInSelectedRegions.Where(c => SelectedGraph.CitiesPassed.Any(cpId => cpId == c.Id)).ToList();
        await PassedCitiesInRegionChanged.InvokeAsync(PassedCitiesInRegion);
        NonPassedCitiesInRegion = citiesInSelectedRegions.Except(PassedCitiesInRegion).ToList();
        await NonPassedCitiesInRegionChanged.InvokeAsync(NonPassedCitiesInRegion);
        await SelectionChanged.InvokeAsync();
    }
}
