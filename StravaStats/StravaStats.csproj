<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
		<UserSecretsId>99f3a98c-58b0-4277-b84e-c8703d742757</UserSecretsId>
		<WarningsAsErrors>$(WarningsAsErrors);RZ2012</WarningsAsErrors>
	</PropertyGroup>

	<ItemGroup>
		<None Remove="Components\Pages\Home.razor.css" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="Components\Pages\Home.razor.css" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.14" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.14" />
		<PackageReference Include="MudBlazor" Version="9.12.0" />
		<PackageReference Include="MudBlazor.Extensions" Version="9.12.2" />
		<PackageReference Include="MudBlazor.FontIcons.MaterialIcons" Version="1.5.0" />
		<PackageReference Include="NetTopologySuite.IO.GeoJSON" Version="4.0.0" />
		<PackageReference Include="NetTopologySuite.IO.GeoPackage" Version="2.0.0" />
		<PackageReference Include="OpenLayers.Blazor" Version="2.6.0" />
		<PackageReference Include="pocketken.H3" Version="4.5.0.1" />
		<PackageReference Include="Polyliner.Net" Version="1.0.2" />
		<PackageReference Include="protobuf-net" Version="3.4.40" />
		<PackageReference Include="protobuf-net.Core" Version="3.4.40" />
		<PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
	</ItemGroup>

</Project>
